    <Owner>
      <Reference class="sailpoint.object.Identity" name="Dana Walker"/>
    </Owner>
    <Requirements>
      <Reference class="sailpoint.object.Bundle" name="PT Warehouse Access"/>
    </Requirements>
    <Selector>
      <IdentitySelector>
        <MatchExpression and="true">
          <MatchTerm name="company" value="Peachtree"/>
          <MatchTerm container="true">
            <MatchTerm name="jobTitle" value="Warehouse Lead"/>
            <MatchTerm name="jobTitle" value="Warehouse Associate"/>
          </MatchTerm>
        </MatchExpression>
      </IdentitySelector>
    </Selector>
