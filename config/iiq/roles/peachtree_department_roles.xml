<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE sailpoint PUBLIC "sailpoint.dtd" "sailpoint.dtd">
<!--
  Peachtree department roles (Day 5, post-merger identity consolidation).

  Design:
    IT roles hold one Peachtree AD group each.
    Business roles are assigned by HR data: company = Peachtree AND jobTitle.
    Each business role requires the IT role(s) for that job.

  On purpose, there is NO role for Finance Manager or IT Manager.
    Finance Manager would hard-code the AP + GL SoD conflict.
    IT Manager would make the helpdesk drift row permanent.
    Their access goes through the mitigated violation and the certification.

  IT roles are listed first so the business role references resolve on import.
-->
<sailpoint>

  <!-- ================= IT ROLES ================= -->

  <Bundle name="PT Dispatch Access" type="it">
    <Attributes>
      <Map>
        <entry key="sysDescriptions">
          <value>
            <Map>
              <entry key="en_US" value="Dispatch Board access through PT_Ops_Dispatch. Granted by the PT Dispatcher and PT Operations Manager business roles."/>
            </Map>
          </value>
        </entry>
      </Map>
    </Attributes>
    <Owner>
      <Reference class="sailpoint.object.Identity" name="Dana Walker"/>
    </Owner>
    <Profiles>
      <Profile>
        <ApplicationRef>
          <Reference class="sailpoint.object.Application" name="Peachtree AD (iamlab)"/>
        </ApplicationRef>
        <Constraints>
          <Filter operation="CONTAINS_ALL" property="memberOf">
            <Value>
              <List>
                <String>CN=PT_Ops_Dispatch,OU=Groups,OU=Peachtree,OU=Acquired,DC=iamlab,DC=local</String>
              </List>
            </Value>
          </Filter>
        </Constraints>
      </Profile>
    </Profiles>
  </Bundle>

  <Bundle name="PT Warehouse Access" type="it">
    <Attributes>
      <Map>
        <entry key="sysDescriptions">
          <value>
            <Map>
              <entry key="en_US" value="WMS access through PT_Ops_Warehouse. Granted by the PT Warehouse Staff business role."/>
            </Map>
          </value>
        </entry>
      </Map>
    </Attributes>
    <Owner>
      <Reference class="sailpoint.object.Identity" name="Dana Walker"/>
