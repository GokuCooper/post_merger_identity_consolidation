          <value>
            <Map>
              <entry key="en_US" value="QuickLedger accounts payable entry through PT_Finance_AP. Conflicts with PT GL Access under the Peachtree AP and GL Separation policy."/>
            </Map>
          </value>
        </entry>
      </Map>
    </Attributes>
    <Owner>
      <Reference class="sailpoint.object.Identity" name="Kiran Patel"/>
    </Owner>
    <Profiles>
      <Profile>
        <ApplicationRef>
          <Reference class="sailpoint.object.Application" name="Peachtree AD (iamlab)"/>
        </ApplicationRef>
        <Constraints>
          <Filter operation="CONTAINS_ALL" property="memberOf">
            <Value>
              <List>
                <String>CN=PT_Finance_AP,OU=Groups,OU=Peachtree,OU=Acquired,DC=iamlab,DC=local</String>
              </List>
            </Value>
          </Filter>
        </Constraints>
      </Profile>
    </Profiles>
  </Bundle>

