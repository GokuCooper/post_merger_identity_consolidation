    </Profiles>
  </Bundle>

  <!-- ================= BUSINESS ROLES ================= -->

  <Bundle name="PT Dispatcher" type="business">
    <Attributes>
      <Map>
        <entry key="sysDescriptions">
          <value>
            <Map>
              <entry key="en_US" value="Assigned automatically when HR says company = Peachtree and jobTitle = Dispatcher."/>
            </Map>
          </value>
        </entry>
      </Map>
    </Attributes>
    <Owner>
      <Reference class="sailpoint.object.Identity" name="Dana Walker"/>
    </Owner>
    <Requirements>
      <Reference class="sailpoint.object.Bundle" name="PT Dispatch Access"/>
    </Requirements>
    <Selector>
      <IdentitySelector>
        <MatchExpression and="true">
          <MatchTerm name="company" value="Peachtree"/>
          <MatchTerm name="jobTitle" value="Dispatcher"/>
        </MatchExpression>
      </IdentitySelector>
    </Selector>
  </Bundle>

  <Bundle name="PT Operations Manager" type="business">
    <Attributes>
      <Map>
        <entry key="sysDescriptions">
          <value>
            <Map>
              <entry key="en_US" value="Assigned automatically when HR says company = Peachtree and jobTitle = Operations Manager. Dispatch only; Warehouse access for this job is a certification decision. Owned by DKN IAM Team so the role holder does not own her own role."/>
            </Map>
          </value>
        </entry>
      </Map>
    </Attributes>
    <Owner>
      <Reference class="sailpoint.object.Identity" name="DKN IAM Team"/>
    </Owner>
    <Requirements>
